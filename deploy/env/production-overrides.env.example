# Reference ONLY: apply the relevant values to EACH separate production service.
# Do not paste this combined list into every service or share migration credentials.
# API + worker:
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://REPLACE_ME_DO_PRIVATE_HOST:25060/gii_prod_db?sslmode=verify-full&sslrootcert=/run/secrets/postgres-ca.crt
# Mount the DO CA in each application at /run/secrets/postgres-ca.crt, read-only.
# Set a distinct gii_prod_api / gii_prod_worker username and password per service.
# Replace stage AWS/provider credentials, Google client IDs and R2 bucket with prod values.

# API only; verify current live endpoint values with the payment providers:
APP_CORS_ALLOWED_ORIGINS=https://globalislamicinstitute.com,https://www.globalislamicinstitute.com
PAYMENTS_CALLBACK_BASE_URL=https://api.globalislamicinstitute.com
PAYMENTS_SSLCOMMERZ_SESSION_API_URL=REPLACE_ME_LIVE_SESSION_URL
PAYMENTS_SSLCOMMERZ_VALIDATION_API_URL=REPLACE_ME_LIVE_VALIDATION_URL
PAYMENTS_BKASH_BASE_URL=REPLACE_ME_LIVE_BKASH_URL
REDIRECT_SUBDOMAIN=api

# Worker only (validation URL is also required on API):
SMS_PROVIDER_BULKSMSBD_BASE_URL=REPLACE_ME_PROVIDER_BASE_URL

# Migrator only; its Compose config mounts POSTGRES_CA_CERT automatically:
FLYWAY_URL=jdbc:postgresql://REPLACE_ME_DO_PRIVATE_HOST:25060/gii_prod_db?sslmode=verify-full&sslrootcert=/run/secrets/postgres-ca.crt
FLYWAY_USER=gii_prod_migration
FLYWAY_PASSWORD=REPLACE_ME
MIGRATION_NETWORK=dokploy-network
# Paste the DO CA as a quoted multiline value in Dokploy, preserving PEM newlines.
POSTGRES_CA_CERT=REPLACE_ME_MULTILINE_DO_CA_PEM
