# Add to API and worker only after the private bucket, IAM policies and CloudFront are configured.
# Leave disabled until the V21 migration has run and both services have been deployed.
RECORDINGS_ENABLED=false
RECORDINGS_S3_BUCKET=
RECORDINGS_S3_REGION=ap-southeast-1
# Optional: leave blank to use the AWS default credential chain (including IAM roles).
# API and worker should have different credentials with the permissions in docs/recordings.md.
RECORDINGS_S3_ACCESS_KEY_ID=
RECORDINGS_S3_SECRET_ACCESS_KEY=

# API only: use a media custom domain on the same parent domain as the public API.
RECORDINGS_CLOUDFRONT_BASE_URL=https://recordings.globalislamicinstitute.com
RECORDINGS_CLOUDFRONT_COOKIE_DOMAIN=globalislamicinstitute.com
RECORDINGS_CLOUDFRONT_KEY_PAIR_ID=
# PKCS#8 RSA private key, PEM or base64-encoded PEM; keep it in the deployment secret store.
RECORDINGS_CLOUDFRONT_PRIVATE_KEY=

# Worker image includes these. Override only for a native development worker.
RECORDINGS_FFMPEG=ffmpeg
RECORDINGS_FFPROBE=ffprobe
