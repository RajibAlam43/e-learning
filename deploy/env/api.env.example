# Copy into the API application's Environment tab in the STAGING Dokploy.
# Replace all REPLACE_ME values. Never commit a completed copy.
SPRING_PROFILES_ACTIVE=stage
SPRING_DATASOURCE_URL=jdbc:postgresql://REPLACE_ME_INTERNAL_DB_HOST:5432/gii_stage_db
SPRING_DATASOURCE_USERNAME=gii_stage_api
SPRING_DATASOURCE_PASSWORD=REPLACE_ME
SPRING_FLYWAY_ENABLED=false
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=70.0 -XX:+ExitOnOutOfMemoryError
SERVER_FORWARD_HEADERS_STRATEGY=native
APP_JWT_SECRET=REPLACE_ME_BASE64_ENCODED_RANDOM_SECRET
APP_CORS_ALLOWED_ORIGINS=https://stage.globalislamicinstitute.com
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
GOOGLE_AUTH_CLIENT_IDS=REPLACE_ME
MUX_TOKEN_ID=REPLACE_ME
MUX_TOKEN_SECRET=REPLACE_ME
MUX_SIGNING_KEY_ID=REPLACE_ME
MUX_SIGNING_PRIVATE_KEY=REPLACE_ME_MULTILINE_PEM
MUX_WEBHOOK_SECRET=REPLACE_ME
BUNNY_API_KEY=REPLACE_ME
R2_ACCOUNT_ID=REPLACE_ME
R2_ACCESS_KEY_ID=REPLACE_ME
R2_SECRET_ACCESS_KEY=REPLACE_ME
R2_BUCKET=REPLACE_ME_STAGE_BUCKET
# Optional for existing stage setups; use a separate bucket before publishing thumbnails.
# R2_PUBLIC_BUCKET=REPLACE_ME_STAGE_PUBLIC_BUCKET
PAYMENTS_SSLCOMMERZ_STORE_ID=REPLACE_ME_SANDBOX_STORE
PAYMENTS_SSLCOMMERZ_STORE_PASSWORD=REPLACE_ME
PAYMENTS_BKASH_USERNAME=REPLACE_ME
PAYMENTS_BKASH_PASSWORD=REPLACE_ME
PAYMENTS_BKASH_APP_KEY=REPLACE_ME
PAYMENTS_BKASH_APP_SECRET=REPLACE_ME
PAYMENTS_BKASH_WEBHOOK_SECRET=REPLACE_ME
ZOOM_ACCOUNT_ID=REPLACE_ME
ZOOM_CLIENT_ID=REPLACE_ME
ZOOM_CLIENT_SECRET=REPLACE_ME
ZOOM_HOST_USER_ID=REPLACE_ME
GOOGLE_CLIENT_ID=REPLACE_ME
GOOGLE_CLIENT_SECRET=REPLACE_ME
# Shared mode only: organizer authorizes meetings.space.created and, when Calendar
# sync is enabled, calendar.events.owned (full Google API scope URLs). See docs/google-meet.md.
# Google Meet API must be enabled; co-hosts require an eligible organizer edition.
GOOGLE_REFRESH_TOKEN=

# Google meeting ownership: false = authorized primary teacher; true = shared eligible organizer.
# The switch affects NEW meetings only. Retain teacher grants for existing teacher-owned meetings.
GOOGLE_MEET_SHARED_ORGANIZER_ENABLED=false
# Teacher mode uses Calendar to support personal Google accounts and invite course teachers.
# Shared mode creates a Meet REST space and optionally mirrors it into Calendar.
GOOGLE_MEET_CALENDAR_SYNC_ENABLED=true
# Generate a dedicated random 32-byte key and base64-encode it. Keep it in the secret store.
# Losing/changing this key requires reconnecting teacher accounts. Never use the example test key.
GOOGLE_MEET_TOKEN_ENCRYPTION_KEY=
GOOGLE_MEET_OAUTH_REDIRECT_URI=https://api.example.com/public/google-meet/oauth/callback
GOOGLE_MEET_OAUTH_RETURN_URL=https://lms.example.com/instructor/live-classes
# false is for HTTP localhost development ONLY.
GOOGLE_MEET_OAUTH_COOKIE_SECURE=true
